# Pragya Shipping - Environment Variables Template
# Copy this file to .env OR set these as system/environment variables

# Database Configuration
DB_PASSWORD=your_secure_database_password_here

# JWT Secret Key (min 32 characters — generate your own for production)
JWT_SECRET_KEY=your_strong_random_jwt_secret_key_here_min_32_chars

# Frontend origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Razorpay (Dashboard → API Keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
